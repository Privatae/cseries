# The door on a member's own machine, for remote access (compose.remote.yaml).
#
# The cloud box's front door (vm/cloud/overlay/etc/caddy/Caddyfile.in): the
# same door rules, from the one file both import (host-door.caddy), with
# three changes here: it listens on the containers' own network only, behind
# the PROXY v2 header the Host's tunnel writes (so the browser's address
# reaches the Host's per-client limits); its certificate is the remote
# address's wildcard, made by door-cert in this image; and the Host it asks
# and passes to is the Host's container address, never loopback. A loopback peer passes
# the Host's session gate without a session (server/middleware/
# owner_session.py), which no browser on the internet may; from here the Host
# sees this container's address. scripts/test_remote_door_loopback.py runs
# this file with a real Caddy between a relay, the tunnel and the Host.
#
# Every value comes from the environment when Caddy reads this file
# (door-run sets them):
#   CSERIES_DOOR_BIND        this container's address on that network
#   CSERIES_DOOR_PORT        the port the tunnel dials (8443)
#   CSERIES_TUNNEL_FROM      the Host container's address: the only peer whose
#                            PROXY header is believed, and the only one let in
#   CSERIES_REMOTE_ZONE      <address_id>.<zone>, the certificate's base
#   CSERIES_HOST_UPSTREAM    the Host's <address>:8800 on that network
#   CSERIES_DOOR_SECRET      the door key (from the door-key volume, never
#                            the compose file)
#   CSERIES_DOOR_TLS         the directory holding cert.pem and key.pem
#   CSERIES_DOOR_ADMIN       Caddy's admin socket (/run/caddy/admin.sock)
{
	admin unix/{$CSERIES_DOOR_ADMIN:/run/caddy/admin.sock}
	# The certificate is the machine's own (door-cert); Caddy fetches none
	# and listens on nothing but the door's port.
	auto_https disable_redirects
	https_port {$CSERIES_DOOR_PORT}
	default_bind {$CSERIES_DOOR_BIND}
	ocsp_stapling off
	servers {
		listener_wrappers {
			# The Host's tunnel starts every connection with the browser's
			# address, and only the Host's address is believed: a PROXY
			# header from anywhere else is refused. Nothing else can reach
			# the door anyway: it is on an internal network with the Host
			# alone (compose.remote.yaml).
			proxy_protocol {
				timeout 5s
				allow {$CSERIES_TUNNEL_FROM}/32
				fallback_policy reject
			}
			tls
		}
		protocols h1 h2
		# The name inside the TLS must be the name the request is for: a
		# browser that reached this door for one of the machine's names
		# cannot ask it about another one.
		strict_sni_host on
		timeouts {
			read_header 10s
			idle 5m
		}
	}
}

https://*.{$CSERIES_REMOTE_ZONE} {
	tls {$CSERIES_DOOR_TLS}/cert.pem {$CSERIES_DOOR_TLS}/key.pem {
		protocols tls1.3
	}
	# The Host's door: the cloud box's own rules, from the one file both
	# doors import (vm/cloud/overlay/etc/caddy/host-door.caddy; this image
	# copies it beside this file).
	import host-door.caddy
}
