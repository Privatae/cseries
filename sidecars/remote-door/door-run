#!/usr/bin/python3 -I
"""The door's entrypoint: the door key, then Caddy, reloaded when the
certificate changes.

The door key is what tells the Host a /__host/door question is this door's
own (server/middleware/owner_session.py). It is made here once, 32 random
bytes in hex, in the door-key volume, which the Host mounts read-only as its
CSERIES_DOOR_SECRET_FILE; it is never written into the compose file or the
environment of anything but this Caddy.

Caddy starts once door-cert has put a certificate in CSERIES_DOOR_TLS; until
then this waits. It checks the certificate every CHECK_S and reloads Caddy
through its admin socket when the file changes.

The zone the certificate is for (<address_id>.<zone>) is CSERIES_REMOTE_ZONE
when that is set, else what the Host wrote to /etc/cseries-cloud/cloud.json
when the owner turned remote access on (server/network/remote_access.py): an
install learns its address only then. A changed zone reloads Caddy with it.
"""

import json
import os
import re
import secrets
import signal
import subprocess
import sys
import time

CONFIG = "/etc/caddy/Caddyfile"
ADMIN = "unix/" + os.environ.get("CSERIES_DOOR_ADMIN", "/run/caddy/admin.sock")
KEY_DIR = os.environ.get("CSERIES_DOOR_KEY_DIR", "/data/door-key")
CHECK_S = 60.0
CLOUD_JSON = os.environ.get("CSERIES_DOOR_CLOUD_JSON", "/etc/cseries-cloud/cloud.json")
_ZONE_RE = re.compile(r"[a-km-np-z][a-km-np-z2-9]{5}(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+")


def log(msg):
    print(f"door: {msg}", file=sys.stderr, flush=True)


def door_key():
    path = os.path.join(KEY_DIR, "door-secret")
    try:
        with open(path, encoding="ascii") as f:
            key = f.read().strip()
        if len(key) >= 32:
            return key
    except FileNotFoundError:
        pass
    key = secrets.token_hex(32)
    tmp = path + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w", encoding="ascii") as f:
        f.write(key + "\n")
    os.replace(tmp, path)
    log("made the door key")
    return key


def stamp(tls):
    try:
        st = os.stat(os.path.join(tls, "cert.pem"))
        return (st.st_mtime_ns, st.st_size)
    except FileNotFoundError:
        return None


def zone():
    """<address_id>.<zone>: the environment's, else cloud.json's; None when
    neither names one that can be."""
    z = (os.environ.get("CSERIES_REMOTE_ZONE") or "").strip().lower()
    if not z:
        try:
            with open(CLOUD_JSON, encoding="utf-8") as f:
                doc = json.load(f)
            z = f"{doc.get('address_id')}.{doc.get('zone')}".lower()
        except (OSError, ValueError, AttributeError):
            return None
    return z if _ZONE_RE.fullmatch(z) and len(z) <= 200 else None


def main():
    env = dict(os.environ, CSERIES_DOOR_SECRET=door_key())
    tls = env["CSERIES_DOOR_TLS"]
    # Every install runs this, and most never turn remote access on: say so
    # once, then wait quietly.
    if stamp(tls) is None or zone() is None:
        log(f"no certificate in {tls} or no remote address yet; waiting for remote access and door-cert")
    while stamp(tls) is None or zone() is None:
        time.sleep(10)
    env["CSERIES_REMOTE_ZONE"] = zone()
    caddy = subprocess.Popen(["caddy", "run", "--config", CONFIG, "--adapter", "caddyfile"], env=env)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda s, _f: caddy.send_signal(s))
    seen = stamp(tls)
    while caddy.poll() is None:
        try:
            caddy.wait(timeout=CHECK_S)
        except subprocess.TimeoutExpired:
            pass
        now, z = stamp(tls), zone()
        if caddy.poll() is None and now is not None and (now != seen or (z and z != env["CSERIES_REMOTE_ZONE"])):
            log("the certificate or the address changed; reloading")
            if z:
                env["CSERIES_REMOTE_ZONE"] = z
            subprocess.run(["caddy", "reload", "--config", CONFIG, "--adapter", "caddyfile",
                            "--address", ADMIN], env=env, check=False)
            seen = now
    return caddy.returncode


if __name__ == "__main__":
    sys.exit(main())
