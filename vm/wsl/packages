# The Debian packages in the WSL guest, on top of Essential and apt
# (mmdebstrap --variant=apt). Their versions are whatever the pinned snapshot
# in build-rootfs.sh holds; Recommends are not installed.
systemd
systemd-sysv
dbus
passwd
podman
crun
conmon
netavark
aardvark-dns
nftables
iptables
# modprobe: WSL mounts its kernel's modules at /usr/lib/modules, but the
# kernel loads one (nf_tables' ct, fib, reject...) only by running modprobe.
# Without it netavark's rules fail with "Could not process rule: No such file
# or directory" and no container starts (measured on WSL 6.6.87.2, 2026-10-21).
kmod
ca-certificates
curl
iproute2
# The local runtime (cseries-runtime) is Python, standard library only, and the
# coding engines' plain proxy is squid.
python3
squid
# The coding engines are built by a user of their own with rootless podman
# (cseries_runtime/build.py): its subordinate ids (newuidmap, newgidmap) and
# its network namespace (pasta).
uidmap
passt
