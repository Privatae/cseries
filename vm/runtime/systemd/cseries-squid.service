# The coding engines' plain proxy: what the platform's node proxy was for them.
# A destination no signed egress rule names goes out here rather than through
# the Host's own event loop. Its own squid on its own config, so Debian's
# default squid (masked) never listens. Only the coding engines and their
# builds may use it, never an app or the browser (squid's ACL and the
# firewall both name the engines' addresses, cseries_runtime/common.py
# PROXY_CLIENTS, and admit a build only from the machine itself).
[Unit]
Description=C-Series plain proxy for the coding engines
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/squid -N -f /etc/cseries-runtime/squid.conf
# squid.conf sets pid_filename none (squid runs in the foreground under
# systemd), so `squid -k reconfigure` cannot find the process and fails
# ("FATAL: no pid_filename configured"). SIGHUP is squid's reconfigure.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
