# What runs once the vault is open: the Host, its database, the local runtime,
# its plain proxy, the bastion, and remote access's door and certificate job
# (units that exist only once cseries-guest configure has given them their
# image; a name with no unit behind it is skipped). cseries-unlock-agent
# starts this after an unlock; at a boot before the claim, multi-user.target
# starts them itself.
[Unit]
Description=C-Series Cloud, unlocked
Requires=cseries-vault.service
After=cseries-vault.service
Wants=cseries-postgres.service cseries-host.service cseries-runtime.socket cseries-squid.service privatae-bastion.service
Wants=cseries-remote-door.service cseries-remote-cert.service
