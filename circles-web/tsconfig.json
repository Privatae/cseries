{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@kit/*": ["../app-web-kit/*"], "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"], "react-dom": ["./node_modules/@types/react-dom"], "react-dom/*": ["./node_modules/@types/react-dom/*"], "radix-ui": ["./node_modules/radix-ui"], "radix-ui/*": ["./node_modules/radix-ui/*"], "lucide-react": ["./node_modules/lucide-react"], "lucide-react/*": ["./node_modules/lucide-react/*"], "class-variance-authority": ["./node_modules/class-variance-authority"], "class-variance-authority/*": ["./node_modules/class-variance-authority/*"], "cmdk": ["./node_modules/cmdk"], "cmdk/*": ["./node_modules/cmdk/*"], "clsx": ["./node_modules/clsx"], "clsx/*": ["./node_modules/clsx/*"], "tailwind-merge": ["./node_modules/tailwind-merge"], "tailwind-merge/*": ["./node_modules/tailwind-merge/*"] }
  },
  "include": ["src"]
}
