#!/usr/bin/python3 -I
"""The unlock page's server: the only thing on this machine that opens the
vault with a customer's key, and the only way to change those keys.

Runs as root under cseries-unlock-agent.socket (/run/cseries-unlock/agent.sock,
root:caddy 0660). Caddy passes it /api/* of unlock-<name>.<address_id>.<zone>
and serves the page itself (/usr/share/cseries-cloud/unlock). JSON in, JSON
out, but for the handoff:

  POST /api/setup           form fields setup_code and email, from the account
                            site's "Set up your machine" (or this page's own
                            form): a handoff cookie, and a redirect to the page
  GET  /api/state           what the page shows: the state, the unlock
                            passkeys (id and PRF salt), a claim's progress,
                            whether this browser holds a handoff, and whether
                            the Host answers and has its owner
  POST /api/unlock          {credential_id, passphrase} | {recovery_key}; also
                            finishes a claim cut off after the bootstrap key
                            went, with the key given (cseries_vault's docstring)
  POST /api/enroll          {setup_code?, passkey: {credential_id, passphrase} | null}
                            -> {recovery_key}, shown once
  POST /api/enroll/confirm  {setup_code?, recovery_key}: starts the claim; the
                            page sends back the key it showed ("I saved it"),
                            which must be the one waiting
  POST /api/keys/add        {auth, credential_id, passphrase}
  POST /api/keys/remove     {auth, credential_id}
  POST /api/keys/recovery   {auth} -> {recovery_key}, shown once
  POST /api/owner-ticket    {auth?} -> {ticket, action}: a one-time ticket
                            that signs the owner in to the Host, or makes
                            the Host's owner when it has none

The setup code reaches this machine only in a POST body: the account site's
card posts it here as a form, and the answer is a cookie (__Host-, Secure,
HttpOnly, SameSite=Strict) and a redirect to the page, so the code is in no
address, no history entry and no Referer. The cookie stands in for the code
for enroll and confirm, and only on requests from this page's own origin:
the Host and its apps are sibling names under the same site, so SameSite
alone would let a page of theirs send it.

auth is {credential_id, passphrase} or {recovery_key}: holding one of the
machine's keys is what lets a person change them, and what gets a sign-in
ticket. Without auth, a ticket goes only to the browser whose handoff set up
the disk's keys, and only to make the Host's owner: once the keys are set up,
nothing but one of them signs anyone in, so the setup code, which Privatae's
platform holds until the box reports its setup done, never does.

A passphrase is what the page derived from the passkey's PRF output
(cseries_vault.passkey_passphrase); the agent never sees the passkey itself.
Every request that checks a key or the setup code counts against its source
(the address Caddy names in X-Forwarded-For, per /64 for IPv6): five a minute.
The page's own calls that the handoff's cookie stands for guess nothing, and
do not count: a person who opens the setup twice is not made to wait.
A refused unlock while the vault is locked is recorded on the plain disk with
the source's /24 or /48 only (cseries_machine.note_attempt). The log has
each request's path and status, never a body or a header.
Standard library only.
"""

import hashlib
import hmac
import html
import ipaddress
import json
import os
import secrets
import signal
import socket
import socketserver
import sys
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler

sys.path.insert(0, "/usr/local/lib/cseries-cloud")
import cseries_cloud as cc  # noqa: E402
import cseries_machine as cm  # noqa: E402
import cseries_vault as cv  # noqa: E402

MAX_BODY = 16 * 1024
TRIES = 5
PER_S = 60.0
CLAIM_UNIT = cm.CLAIM_UNIT
# The account site whose machine card posts the handoff.
ACCOUNT_ORIGIN = "https://privatae.ai"
HANDOFF_COOKIE = "__Host-cseries-setup"
# A handoff lasts through the disk's re-encryption, which takes minutes on
# the largest machine: after it, the person's own key does what it did.
HANDOFF_TTL_S = 2 * 3600
HANDOFF_KEEP = 8
# A ticket is posted to the Host the moment it is made.
TICKET_TTL_S = 120
EMAIL_MAX = 254


class Refused(Exception):
    def __init__(self, msg, status=400, **extra):
        super().__init__(msg)
        self.status = status
        self.extra = extra


def cookie_values(header, name):
    """Every value the Cookie header(s) give `name`."""
    out = []
    for part in (header or "").split(";"):
        k, sep, v = part.strip().partition("=")
        if sep and k == name and v:
            out.append(v.strip())
    return out


def normal_email(raw):
    email = (raw or "").strip().lower() if isinstance(raw, str) else ""
    if "@" not in email or len(email) > EMAIL_MAX or any(c.isspace() or ord(c) < 0x20 for c in email):
        return None
    return email


def refusal_page(msg):
    """What a refused handoff shows: it arrived as a navigation, so the
    answer is a page, with the way to the unlock page itself."""
    return ('<!doctype html><html lang="en"><head><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width, initial-scale=1">'
            '<title>Set up this machine · C-Series</title><link rel="stylesheet" href="/unlock.css">'
            f'</head><body><main><h1>This machine</h1><p id="err">{html.escape(msg)}</p>'
            '<p><a class="button" href="/">Go to this machine&#39;s page</a></p></main></body></html>')


def source_key(xff):
    """Whose tries these are: the address Caddy saw, per /64 for IPv6."""
    addr = (xff or "").split(",")[-1].strip()
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return "unknown"
    if ip.version == 6 and ip.ipv4_mapped:
        return str(ip.ipv4_mapped)
    if ip.version == 6:
        return str(ipaddress.ip_network(f"{ip}/64", strict=False))
    return str(ip)


class Limiter:
    def __init__(self, now=time.monotonic):
        self.now = now
        self.tries = {}

    def take(self, key):
        t = self.now()
        recent = [s for s in self.tries.get(key, []) if t - s < PER_S]
        if len(recent) >= TRIES:
            raise Refused(f"Too many tries. Wait {int(PER_S - (t - min(recent))) + 1} seconds.", 429)
        recent.append(t)
        self.tries[key] = recent
        if len(self.tries) > 10_000:
            for k in [k for k, v in self.tries.items() if all(t - s >= PER_S for s in v)]:
                del self.tries[k]


class Agent:
    """The requests, without the HTTP: tests drive this directly."""

    def __init__(self, paths, vault=None, runner=None, limiter=None, now=time.time,
                 owner=cm.host_has_owner):
        self.paths = paths
        self.vault = vault or cv.Vault(paths)
        self.runner = runner or self.vault.run
        self.limiter = limiter or Limiter()
        self.now = now
        self.owner = owner

    def cfg(self):
        return cc.load_cloud(self.paths)

    def own_origin(self):
        return "https://" + cm.unlock_host(self.cfg())

    def stored_setup_code(self):
        """The setup code the provisioner made for this machine, the one the
        Host's /setup takes too (cseries-cloud-bootstrap mounts the same file
        into it as CSERIES_SETUP_CODE_FILE); "" when the file is empty."""
        try:
            with open(self.paths.setup_code(), encoding="utf-8") as f:
                return f.read().strip().lower()
        except FileNotFoundError:
            raise Refused("This machine has no setup code.", 409) from None

    def setup_code_ok(self, code):
        want = self.stored_setup_code()
        got = (code or "").strip().lower() if isinstance(code, str) else ""
        return bool(want) and hmac.compare_digest(got.encode(), want.encode())

    # ── the handoff ─────────────────────────────────────────────────────────

    def _handoffs(self):
        doc = cc.read_json(self.paths.p(cm.HANDOFF), None)
        recs = doc.get("handoffs") if isinstance(doc, dict) else None
        t = self.now()
        return {h: r for h, r in (recs or {}).items()
                if isinstance(r, dict) and isinstance(r.get("until"), (int, float)) and r["until"] > t}

    def _keep_handoffs(self, recs):
        os.makedirs(self.paths.p(cv.RUN), mode=0o755, exist_ok=True)
        newest = sorted(recs.items(), key=lambda kv: kv[1]["until"])[-HANDOFF_KEEP:]
        cc.write_json(self.paths.p(cm.HANDOFF), {"handoffs": dict(newest)}, mode=0o600)

    def handoff(self, headers, post=True):
        """(hash, record) of the handoff this request's cookie names, or
        None. Only from this page's own origin: a fetch from a sibling name
        under the same site carries the cookie too, and its Origin says so.
        A browser sends Origin with every POST, so a POST without it is
        not the page's; a GET from the page itself (the state) carries none,
        and only reads."""
        headers = headers or {}
        origin = headers.get("origin")
        if (post or origin is not None) and origin != self.own_origin():
            return None
        recs = self._handoffs()
        for value in cookie_values(headers.get("cookie"), HANDOFF_COOKIE):
            h = hashlib.sha256(value.encode("ascii", "replace")).hexdigest()
            if h in recs:
                return h, recs[h]
        return None

    def setup_handoff(self, body_bytes, source, headers):
        """POST /api/setup: the account site's card (or this page's own form)
        hands over the setup code and the owner's email in a form body. The
        answer is the page itself, by a 303, and a cookie that stands for the
        code in this browser for HANDOFF_TTL_S."""
        headers = headers or {}
        origin = headers.get("origin")
        if origin not in (ACCOUNT_ORIGIN, self.own_origin()):
            raise Refused("This machine's setup opens from your account at privatae.ai: "
                          "press Set up your machine there.", 403)
        if cm.setup_done(self.paths):
            # Its keys are set up and its Host has its owner: nothing is left
            # that a handoff does, so the setup code does nothing here.
            raise Refused("This machine is set up. Sign in to your Host from this machine's page.", 409)
        ctype = (headers.get("content-type") or "").split(";")[0].strip().lower()
        if ctype != "application/x-www-form-urlencoded":
            raise Refused("The setup did not arrive as a form.", 415)
        self.limiter.take(source)
        try:
            form = urllib.parse.parse_qs(body_bytes.decode("utf-8"), max_num_fields=8,
                                         strict_parsing=False)
        except (UnicodeDecodeError, ValueError):
            raise Refused("The setup did not arrive as a form.") from None
        code = (form.get("setup_code") or [""])[0]
        email = normal_email((form.get("email") or [""])[0])
        if not self.setup_code_ok(code):
            raise Refused("That setup code is not this machine's. Open the setup again from "
                          "your account at privatae.ai.", 403)
        if email is None:
            raise Refused("Enter a valid email address.", 400)
        token = secrets.token_urlsafe(32)
        recs = self._handoffs()
        recs[hashlib.sha256(token.encode("ascii")).hexdigest()] = {
            "email": email, "until": self.now() + HANDOFF_TTL_S, "ran_claim": False}
        self._keep_handoffs(recs)
        cookie = (f"{HANDOFF_COOKIE}={token}; Max-Age={HANDOFF_TTL_S}; Path=/; Secure; HttpOnly; "
                  "SameSite=Strict")
        return 303, b"", [("Location", "/"), ("Set-Cookie", cookie)]

    def _mark_ran_claim(self, h):
        """The handoff `h` started the claim now running, and no other did
        (h None: a typed code, no handoff)."""
        recs = self._handoffs()
        for k, r in recs.items():
            r["ran_claim"] = k == h
        if recs:
            self._keep_handoffs(recs)

    # ── what the page shows ─────────────────────────────────────────────────

    def state(self, headers=None):
        cfg = self.cfg()
        v = self.vault
        st = v.state()
        ho = self.handoff(headers, post=False)
        out = {"state": st, "name": cfg["name"], "machine_id": cfg["machine_id"],
               "rp_id": cm.unlock_host(cfg), "host_url": "https://" + cc.host_name(cfg) + "/",
               "enrolled": v.enrolled() if st != "absent" else None,
               "claim": cm.claim_status(self.paths), "passkeys": [], "salt": None,
               "recovery": False, "claiming": False, "resume": False, "dropped": [],
               "handoff": ho is not None, "handoff_claim": bool(ho and ho[1].get("ran_claim")),
               "host": None}
        if st != "absent":
            out["claiming"] = self.claim_running()
        if st != "absent" and not out["claiming"]:
            # Not while the claim runs: reading the header waits for the
            # re-encryption's lock, and the page polls this every 2 s.
            d = v.dump()
            out["passkeys"] = [{"credential_id": k["credential_id"], "salt": k["salt"],
                                "added_at": k["added_at"]} for k in v.passkeys(d)]
            out["salt"] = (v.config() or {}).get("salt")
            out["recovery"] = v._slotted(cv.TOKEN_RECOVERY, d) is not None
            # A claim cut off after the bootstrap key went: the page asks
            # for one of the customer's keys to finish it (unlock).
            out["resume"] = v.claim_unfinished(d)
            # Keys a claim cut off before its re-encryption had to drop,
            # which the page asks the customer to make again.
            out["dropped"] = list((v.config() or {}).get("claim_dropped") or [])
            if st == "open" and out["enrolled"]:
                # Whether the Host answers, and has its owner: the page waits
                # for the first before it posts a ticket, and the second says
                # which.
                owner = self.owner()
                out["host"] = {"up": owner is not None, "owner": owner}
        return out

    def unlock(self, body, source):
        self.limiter.take(source)
        v = self.vault
        if v.state() == "absent":
            raise Refused("This machine has no vault.", 409)
        how = "the recovery key" if "recovery_key" in body else "a passkey"
        if v.state() == "open":
            if self.claim_running() or not v.claim_unfinished():
                return {"ok": True, "next": self.state()["host_url"], "already": True}
            # A claim cut off after the bootstrap key went, its unit not
            # running (it stopped): one of the customer's keys finishes it.
            try:
                key, _slot = v.authorise(body)
            except cv.VaultError as e:
                cm.note_attempt(self.paths, v, how, source, False, str(e))
                raise Refused(str(e), 403) from None
            cm.resume_claim(self.paths, self.runner, key)
            return {"ok": True, "next": self.state()["host_url"], "claiming": True}
        try:
            if "recovery_key" in body:
                key = cv.recovery_passphrase(body.get("recovery_key"))
                how = v.unlock_recovery(body.get("recovery_key"))
            else:
                key = body.get("passphrase")
                how = v.unlock_passkey(body.get("credential_id"), key)
        except cv.VaultError as e:
            cm.note_attempt(self.paths, v, how, source, False, str(e))
            raise Refused(str(e), 403) from None
        out = {"ok": True}
        if cm.after_open(self.paths, self.cfg(), v, self.runner, how, source, key=key):
            out["claiming"] = True
        out["next"] = self.state()["host_url"]
        return out

    def _pre_claim(self, body, source, headers):
        """The handoff that may set up the keys: this browser's (by its
        cookie), or the setup code typed into the body. Returns the
        handoff's hash, or None for a typed code. A typed code is a guess
        and counts against its source; the handoff's cookie is not."""
        ho = self.handoff(headers)
        if ho is None:
            self.limiter.take(source)
        v = self.vault
        if v.state() != "open":
            raise Refused("This machine is not open.", 409)
        if v.enrolled() or v.bootstrap_key() is None:
            raise Refused("This machine's keys are already set up. Use one of them to change them.", 409)
        if ho is not None:
            return ho[0]
        if not self.setup_code_ok(body.get("setup_code")):
            raise Refused("Open this machine's setup from your account at privatae.ai: "
                          "press Set up your machine there.", 403, handoff=False)
        return None

    def enroll(self, body, source, headers=None):
        self._pre_claim(body, source, headers)
        if self.claim_running():
            raise Refused("The disk is being set up already.", 409)
        pk = body.get("passkey")
        passkey = None
        if pk is not None:
            if not isinstance(pk, dict):
                raise Refused("passkey must be an object or null")
            try:
                passkey = {"credential_id": cv.check_credential_id(pk.get("credential_id")),
                           "passphrase": cv.check_passphrase(pk.get("passphrase"))}
            except cv.VaultError as e:
                raise Refused(str(e)) from None
        shown, passphrase = cv.new_recovery_key()
        os.makedirs(self.paths.p(cv.RUN), mode=0o755, exist_ok=True)
        cc.write_json(self.paths.p(cm.PENDING), {"passkey": passkey, "recovery_pass": passphrase,
                                                 "confirmed": False}, mode=0o600)
        return {"ok": True, "recovery_key": shown}

    def confirm(self, body, source, headers=None):
        """The owner says the recovery key is saved (the page's Download and
        "I saved it"), so the claim starts. The page sends back the key it
        showed (or the person retypes it), and it must be the one waiting:
        a second tab or browser that enrolled since made another, and the
        disk must never be sealed with a key other than the one the person
        saved."""
        h = self._pre_claim(body, source, headers)
        pending = cc.read_json(self.paths.p(cm.PENDING), None)
        if not isinstance(pending, dict):
            raise Refused("Start again: no key is waiting to be saved.", 409)
        try:
            typed = cv.recovery_passphrase(body.get("recovery_key"))
        except cv.VaultError as e:
            raise Refused(str(e)) from None
        if not hmac.compare_digest(typed.encode(), str(pending.get("recovery_pass")).encode()):
            raise Refused("That is not the recovery key this machine waits for. If its setup was started "
                          "again in another tab or browser, delete the key you saved from here, then "
                          "finish the setup there, or start it again here.", 403, replaced=True)
        if self.claim_running():
            return {"ok": True, "started": False}
        # A failed claim's report from before would read as this one's.
        cc.write_json(self.paths.p(cm.CLAIM), {"phase": "starting", "error": None,
                                               "started_at": cm.iso()})
        cm.start_claim(self.runner)
        # This browser's handoff, and no other, may make the Host's owner
        # without a key once the keys are set up (owner_ticket); none when the
        # code was typed. One whose claim stopped before this one loses that.
        self._mark_ran_claim(h)
        return {"ok": True, "started": True}

    def claim_running(self):
        r = self.runner(["/usr/bin/systemctl", "is-active", "--quiet", CLAIM_UNIT + ".service"],
                        check=False)
        return getattr(r, "returncode", 1) == 0

    def _keys(self, fn, body, source):
        self.limiter.take(source)
        if self.vault.state() != "open":
            raise Refused("Unlock this machine first.", 409)
        try:
            return fn()
        except cv.VaultError as e:
            raise Refused(str(e), 403) from None

    def keys_add(self, body, source, headers=None):
        def run():
            self.vault.add_passkey(body.get("auth"), body.get("credential_id"), body.get("passphrase"))
            cm.publish(self.paths, self.cfg(), self.vault)
            return {"ok": True}
        return self._keys(run, body, source)

    def keys_remove(self, body, source, headers=None):
        def run():
            self.vault.remove_passkey(body.get("auth"), body.get("credential_id"))
            cm.publish(self.paths, self.cfg(), self.vault)
            return {"ok": True}
        return self._keys(run, body, source)

    def keys_recovery(self, body, source, headers=None):
        def run():
            return {"ok": True, "recovery_key": self.vault.replace_recovery(body.get("auth"))}
        return self._keys(run, body, source)

    def owner_ticket(self, body, source, headers=None):
        """A one-time ticket for the Host (cseries_machine.write_owner_claim):
        "claim" makes the Host's owner, with the handoff's email, when it
        has none; "sign-in" signs its owner in. With one of the disk's keys
        (auth) either; without, only "claim", and only for the browser whose
        handoff set up the keys (confirm). The page posts the ticket to the
        Host's `action` as a form at once. A key is a guess and counts
        against its source, as does a request with no handoff; the page's
        own call with the handoff's cookie does not."""
        ho = self.handoff(headers)
        keyed = "auth" in body
        if keyed or ho is None:
            self.limiter.take(source)
        v = self.vault
        if v.state() != "open":
            raise Refused("Unlock this machine first.", 409)
        if self.claim_running() or not v.enrolled():
            raise Refused("The disk is still being set up.", 409)
        if keyed:
            try:
                v.authorise(body.get("auth"))
            except cv.VaultError as e:
                raise Refused(str(e), 403) from None
        elif not (ho and ho[1].get("ran_claim")):
            raise Refused("Confirm with your passkey or your recovery key.", 403, need_key=True)
        owner = self.owner()
        if owner is None:
            raise Refused("Your Host is starting. This takes a few seconds.", 503, starting=True)
        cfg = self.cfg()
        if owner:
            cm.note_setup_done(self.paths)
            if not keyed:
                raise Refused("Your Host has its owner. Confirm with your passkey or your "
                              "recovery key to sign in.", 403, need_key=True)
            kind, email, route = "sign-in", None, "api/owner/box-sign-in"
        else:
            email = ho[1].get("email") if ho else None
            if not email:
                raise Refused("Your Host has no owner yet. Open this machine's setup from your "
                              "account at privatae.ai, or enter its setup code below.", 409,
                              handoff=False)
            kind, route = "claim", "api/owner/claim"
        ticket = secrets.token_urlsafe(32)
        cm.write_owner_claim(self.paths, kind, email, ticket, TICKET_TTL_S, now=self.now())
        return {"ok": True, "kind": kind, "ticket": ticket,
                "action": "https://" + cc.host_name(cfg) + "/" + route}

    ROUTES = {
        ("POST", "/api/unlock"): "unlock",
        ("POST", "/api/enroll"): "enroll",
        ("POST", "/api/enroll/confirm"): "confirm",
        ("POST", "/api/keys/add"): "keys_add",
        ("POST", "/api/keys/remove"): "keys_remove",
        ("POST", "/api/keys/recovery"): "keys_recovery",
        ("POST", "/api/owner-ticket"): "owner_ticket",
    }
    # Handed headers too: the ones that read the handoff cookie.
    WITH_HEADERS = frozenset({"enroll", "confirm", "owner_ticket"})
    HANDOFF_PATH = "/api/setup"

    def respond(self, method, path, body_bytes, xff, headers=None):
        """(status, body, extra headers) for one request: the body is a JSON
        object, or bytes for the handoff's redirect and its refusal page."""
        path = path.split("?", 1)[0]
        headers = {k.lower(): v for k, v in (headers or {}).items()}
        try:
            if method == "POST" and path == self.HANDOFF_PATH:
                try:
                    return self.setup_handoff(body_bytes or b"", source_key(xff), headers)
                except Refused as e:
                    return e.status, refusal_page(str(e)).encode("utf-8"), \
                        [("Content-Type", "text/html; charset=utf-8")]
            if method == "GET" and path == "/api/state":
                return 200, self.state(headers), []
            name = self.ROUTES.get((method, path))
            if name is None:
                return 404, {"error": "not found"}, []
            try:
                body = json.loads(body_bytes or b"{}")
            except ValueError:
                raise Refused("The request is not JSON.") from None
            if not isinstance(body, dict):
                raise Refused("The request is not a JSON object.")
            fn = getattr(self, name)
            out = fn(body, source_key(xff), headers) if name in self.WITH_HEADERS \
                else fn(body, source_key(xff))
            return 200, out, []
        except Refused as e:
            return e.status, dict(e.extra, error=str(e)), []
        except (cv.VaultError, cc.CloudError, OSError) as e:
            print(f"cseries-unlock-agent: {method} {path}: {e}", file=sys.stderr, flush=True)
            return 500, {"error": "The machine could not do that. Try again in a moment."}, []

    def handle(self, method, path, body_bytes, xff, headers=None):
        """(status, answer) for one request."""
        status, out, _extra = self.respond(method, path, body_bytes, xff, headers)
        return status, out


class Handler(BaseHTTPRequestHandler):
    agent = None
    server_version = "cseries-unlock"
    sys_version = ""

    def address_string(self):
        return "caddy"

    def log_message(self, fmt, *args):
        # Paths and statuses only; never a body or a header (the handoff's
        # code is in its body, its cookie in a header).
        print(f"cseries-unlock-agent: {self.command} {self.path.split('?', 1)[0]} {fmt % args}",
              file=sys.stderr, flush=True)

    def _answer(self, status, obj, extra=()):
        is_json = not isinstance(obj, bytes)
        data = json.dumps(obj).encode("utf-8") if is_json else obj
        self.send_response(status)
        names = {k.lower() for k, _v in extra}
        if "content-type" not in names and (is_json or data):
            self.send_header("Content-Type", "application/json")
        for k, v in extra:
            self.send_header(k, v)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _go(self, method):
        n = int(self.headers.get("Content-Length") or 0)
        if n > MAX_BODY:
            self._answer(413, {"error": "The request is too large."})
            return
        body = self.rfile.read(n) if n else b""
        heads = {"cookie": "; ".join(self.headers.get_all("Cookie") or []) or None,
                 "origin": self.headers.get("Origin"),
                 "content-type": self.headers.get("Content-Type")}
        self._answer(*self.agent.respond(method, self.path, body, self.headers.get("X-Forwarded-For"),
                                         {k: v for k, v in heads.items() if v is not None}))

    def do_GET(self):
        self._go("GET")

    def do_POST(self):
        self._go("POST")


class Server(socketserver.UnixStreamServer):
    """One request at a time, and a stop (SIGTERM: the updater's
    try-restart, a shutdown) waits for the one in hand. Cut off half way, a
    key change leaves the vault's header between its steps (a new recovery
    key added, the old one killed, the new one never shown) and an unlock
    the vault open with the Host never started (after_open), and the vault
    counts as open, so the updater runs, before after_open is done. The
    unit's KillMode=mixed sends the SIGTERM to this process alone, so the
    cryptsetup it waits for finishes too."""

    def __init__(self, sock):
        socketserver.BaseServer.__init__(self, "", Handler)
        self.socket = sock
        self.busy = False
        self.stopping = False

    def get_request(self):
        conn, _ = self.socket.accept()
        self.busy = True
        conn.settimeout(30)
        return conn, ("caddy", 0)

    def process_request(self, request, client_address):
        try:
            super().process_request(request, client_address)
        finally:
            self.busy = False
            if self.stopping:
                raise SystemExit(0)

    def stop(self, _signum=None, _frame=None):
        """SIGTERM's handler: now between requests, else once the answer
        to the one in hand is sent."""
        self.stopping = True
        if not self.busy:
            raise SystemExit(0)


def main():
    if os.geteuid() != 0:
        print("cseries-unlock-agent runs as root", file=sys.stderr)
        return 2
    if os.environ.get("LISTEN_FDS") != "1" or os.environ.get("LISTEN_PID") != str(os.getpid()):
        print("cseries-unlock-agent runs under cseries-unlock-agent.socket", file=sys.stderr)
        return 2
    Handler.agent = Agent(cc.Paths())
    server = Server(socket.socket(fileno=3))
    signal.signal(signal.SIGTERM, server.stop)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
