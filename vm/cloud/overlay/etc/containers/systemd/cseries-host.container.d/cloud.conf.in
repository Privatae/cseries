# The Host on a cloud box (bootstrap renders this file). A Quadlet drop-in's
# Environment= replaces the unit's value for the same name, so these win over
# cseries-host.container's local defaults.
#
# CSERIES_TRUSTED_PROXIES is the address the Host sees Caddy's connections
# come from: Caddy, on this machine, connects to the container's fixed
# address, so they arrive from the box's own end of the containers' bridge.
# With remote access configured, cseries-guest's remote.conf (which comes
# after this file) replaces it with the same address, read from
# /etc/cseries/front-proxies, and the remote door's: both doors stay trusted.
# The door key here is this box's front door's; the remote door's is
# CSERIES_REMOTE_DOOR_SECRET_FILE, mounted at /run/cseries-remote-door and
# never on /run/cseries-door below.
[Container]
Environment=CSERIES_URL=https://@HOST_NAME@
Environment=CSERIES_TRUSTED_PROXIES=@TRUSTED_PROXIES@
Environment=CSERIES_LANE_HOST=@HOST_NAME@
Environment=CSERIES_DOOR_HELPER=/run/cseries-door/helper.sock
# The door key (cseries_cloud.ensure_door_key), read-only: the Host answers
# Caddy's forward_auth question at /__host/door only when it carries this key.
Volume=/etc/cseries-cloud/door-secret:/run/cseries-cloud/door-secret:ro
Environment=CSERIES_DOOR_SECRET_FILE=/run/cseries-cloud/door-secret
# The bastion on this machine pairs and dials in through unix sockets here
# (etc/tmpfiles.d/privatae-host.conf), and the pairing-window helper listens
# in /run/cseries-door. The two groups are the ones those directories belong to.
Volume=/run/privatae-host:/run/privatae-host
Volume=/run/cseries-door:/run/cseries-door
# The machine writes its vault's state, its access log and its unlock record
# into that same directory (cseries_machine.publish), which the Host can read
# and cannot write: the owner's Machine page shows them, and /setup waits for
# the vault's keys.
Environment=CSERIES_MACHINE_DIR=/run/cseries-door
GroupAdd=@PRIVATAE_HOST_GID@
GroupAdd=@CSERIES_GID@
