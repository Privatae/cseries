# The unlock page's server. Caddy (user caddy) connects for /api/* of
# unlock-<name>.<address_id>.<zone>; nobody else can.
[Unit]
Description=C-Series Cloud unlock agent socket

[Socket]
ListenStream=/run/cseries-unlock/agent.sock
SocketUser=root
SocketGroup=caddy
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
