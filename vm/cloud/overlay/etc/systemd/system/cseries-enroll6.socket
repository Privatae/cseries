# The Host's port 8810 for IPv6 callers. The quadlet's 127.0.0.1:8810 publish
# holds the port on the box's IPv4 side, so this listens on a v6-only socket
# and relays to the container (cseries-enroll6.service). door.nft decides who
# may connect: only an address in pairing_v6.
[Unit]
Description=C-Series Cloud IPv6 relay to the Host's port 8810
After=cseries-firewall.service

[Socket]
ListenStream=[::]:8810
BindIPv6Only=ipv6-only
FreeBind=yes

[Install]
WantedBy=sockets.target
