{
  "name": "sites-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sites — publish, configure, and run your own public websites. React + shadcn control panel over the kernel's caller-scoped /api/applications/sites routes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "place": "node ../app-web-kit/place.mjs sites",
    "ship": "node ../app-web-kit/verify-node-modules.mjs && vite build && node ../app-web-kit/place.mjs sites",
    "preview": "vite preview",
    "test": "node --test test/"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.500.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
