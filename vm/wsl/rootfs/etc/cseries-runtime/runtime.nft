#!/usr/sbin/nft -f
# The local runtime's firewall on a machine with no other (the WSL guest;
# a cloud box carries the same rules in its door.nft). Loaded by
# cseries-runtime-firewall.service before the runtime starts. Its own two
# tables, each replaced whole on every load, so nothing else is touched.
#
# The apps network (10.89.78.0/24) has no default route; these make sure:
#   input    from it, only DNS (aardvark) and the plain proxy on the gateway;
#            the proxy's port from nowhere else
#   forward  nothing routed out of it, nothing routed into it
#   bridge   a frame between two of its ports passes only when one end is the
#            Host (10.89.78.2), and a new connection to the Host only on its
#            web port and its egress gate: containers cannot reach each other

define APPS_NET = 10.89.78.0/24
define APPS_GW = 10.89.78.1
define APPS_HOST = 10.89.78.2
# Who on the network may use the plain proxy: the coding engines
# (cseries_runtime/common.py PROXY_CLIENTS), never an app. An engine build
# reaches it as BUILD_UID below, from the machine.
define APPS_PROXY_CLIENTS = { 10.89.78.240-10.89.78.247 }
# The user engine builds run as (cseries_runtime/common.py BUILD_UID): its
# sockets carry every RUN step's traffic (pasta) and podman's own pulls, and
# reach the plain proxy and nothing else.
define BUILD_UID = 199999

table inet cseries_runtime
delete table inet cseries_runtime

table inet cseries_runtime {
	chain input {
		type filter hook input priority filter; policy accept;
		# The network is IPv4 only; the rules below name IPv4, so anything
		# else from its bridge (a link-local IPv6 address) is dropped first.
		iifname "cseries-apps0" meta nfproto ipv6 drop
		ct state established,related accept
		ip saddr $APPS_NET ip daddr $APPS_GW meta l4proto { tcp, udp } th dport 53 accept
		ip saddr $APPS_PROXY_CLIENTS ip daddr $APPS_GW tcp dport 3128 accept
		# A build's connections to the proxy, from the machine itself.
		iif lo ip saddr $APPS_GW ip daddr $APPS_GW tcp dport 3128 accept
		ip saddr $APPS_NET drop
		tcp dport 3128 drop
	}
	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid $BUILD_UID ip daddr $APPS_GW tcp dport 3128 accept
		meta skuid $BUILD_UID drop
	}
	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname "cseries-apps0" meta nfproto ipv6 drop
		oifname "cseries-apps0" meta nfproto ipv6 drop
		ip saddr $APPS_NET ip daddr != $APPS_NET drop
		ip daddr $APPS_NET ip saddr != $APPS_NET drop
	}
}

table bridge cseries_apps
delete table bridge cseries_apps

table bridge cseries_apps {
	chain forward {
		type filter hook forward priority filter; policy accept;
		meta ibrname != "cseries-apps0" accept
		ether type arp accept
		ip saddr $APPS_HOST accept
		ip daddr $APPS_HOST tcp dport { 8800, 13129 } accept
		ip daddr $APPS_HOST tcp flags & (syn | ack) != syn accept
		drop
	}
}
