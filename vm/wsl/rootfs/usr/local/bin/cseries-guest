#!/bin/sh
# The guest's half of the cseries command. The command on the machine runs
# these as root through the VM's exec channel (on Windows,
# `wsl.exe -d cseries -u root --exec cseries-guest <command>`), so this file is
# the whole interface between the two and nothing here listens on a network.
#
#   wait-boot          wait until systemd has finished starting
#   configure          read the pinned images from stdin (host=, postgres=,
#                      release=, and optionally cpu_quota=, memory_max=
#                      and door=, the remote-access door's image, which its
#                      door and certificate units both run, and with which
#                      the Host joins the door's network) and write them
#                      where the units read them; on a machine with the
#                      local runtime also its
#                      images (python=, creative=, helper=, browser=, each
#                      pinned by digest) and the engines' sources
#                      (harness_src_url=, harness_src_sha256=), the
#                      browser's control token, and the Host's drop-in that
#                      joins it to the runtime
#   pull               pull both images (and the runtime's python image, and
#                      the door's when one is configured), with progress
#   start | stop | restart
#                      the Host and its database, waiting until both run;
#                      the door's two units beside them, never waited on
#   status             key=value lines, cpus= and mem_total_kb= among them
#                      (this system's processor count and MemTotal), and
#                      door= and remote_cert= (the door's two units)
#   health             exit 0 when the Host answers on 127.0.0.1:8800
#   ready              exit 0 when the Host's deep health check says ready:
#                      its database, its migrations and its runtime are up
#   logs host|postgres [--follow] [--lines N]
#   host-log           the current Host container's own output
#   pair-token         a one-time pairing token for the bastion, as JSON
#   keepalive          hold the VM up while it runs; a second one exits at
#                      once, so starting it at every login never piles up
#   version            the guest image's version
set -eu

# Every path is under CSERIES_GUEST_ROOT, which only a test sets.
R=${CSERIES_GUEST_ROOT:-}
UNITS=$R/etc/containers/systemd
STATE=$R/etc/cseries
RT_ETC=$R/etc/cseries-runtime
RT_BIN=$R/usr/local/sbin/cseries-runtime
RT_NET=10.89.78.0/24
RT_HOST_IP=10.89.78.2
# The Host's MAC there, made from its address as the runtime makes its
# containers' (cseries_runtime/common.py mac_for), so it is the same after a
# restart and no neighbour cache keeps a dead one.
RT_HOST_MAC=02:63:0a:59:4e:02

die() { printf '%s\n' "$*" >&2; exit 1; }

# A command can arrive in the root of the guest's cgroup tree: docker exec puts
# one there while systemd has not yet enabled any controllers, and where WSL's
# exec channel puts its processes is not something this file can know. While a
# process sits in that root, and the root is not the kernel's own (a
# container's or a namespace's), the kernel refuses to enable controllers
# below it, so systemd cannot, and the containers fail to start with
# "controller pids is not available". A command found there moves itself
# into init.scope first, as runc does.
leave_root_cgroup() {
    if [ "$(cat /proc/self/cgroup 2>/dev/null)" = "0::/" ] && [ -d /sys/fs/cgroup/init.scope ]; then
        echo $$ > /sys/fs/cgroup/init.scope/cgroup.procs 2>/dev/null || true
    fi
}
leave_root_cgroup

# Remote access's two units (cseries-remote-door.container and
# cseries-remote-cert.container), which run the door's image. Neither is
# waited on: a door that cannot start never keeps the Host from starting.
DOOR_UNITS="cseries-remote-door.service cseries-remote-cert.service"
# The Host's and the door's addresses on the remote network
# (cseries-remote.network, 10.89.79.0/29; cseries-remote-door.container).
REMOTE_HOST_IP=10.89.79.2
REMOTE_DOOR_IP=10.89.79.3

remote_host_dropin() {
    # The Host's drop-in for remote access (compose.remote.yaml's host
    # service), written by configure only once it has the door's image: until
    # then the Host names no remote network, so a Host without the door never
    # depends on that network being made.
    cat <<EOF
# Written by cseries-guest configure with the remote-access door's image.
#
# The Host's address on the remote network, where its door reaches it, and
# what the Host needs to hand browsers to the door and to answer it.
#
# CSERIES_REMOTE_DOOR is the door's own address, never loopback: a request
# from loopback is let into the Host without a session, so a browser from the
# internet must arrive from the door's address. The Host believes the door's
# X-Forwarded-For and answers its /__host/door question only from exactly the
# door's /32. This drop-in's CSERIES_TRUSTED_PROXIES replaces the base unit's
# empty one: Quadlet reads drop-ins after the unit, in name order, and the
# last value given for a variable is the one the container gets.
#
# The volumes: the door key the door makes (read-only here); the remote-acme
# directory, where the Host writes what the certificate job reads (the zone,
# the ACME account it made, and the acme-dns credential the network hands it
# once); and the job's status, read-only, for Settings. Each is shared with
# the door or its certificate job, so each is named by its own unit
# (cseries-remote-*.volume), which makes it once before any of them starts.
[Container]
Network=cseries-remote.network:ip=$REMOTE_HOST_IP
Environment=CSERIES_REMOTE_DOOR=$REMOTE_DOOR_IP:8443
Environment=CSERIES_TRUSTED_PROXIES=$REMOTE_DOOR_IP/32
Environment=CSERIES_DOOR_SECRET_FILE=/run/cseries-door/door-secret
Environment=CSERIES_REMOTE_ACME_DIR=/var/lib/cseries-remote
Environment=CSERIES_REMOTE_CERT_STATUS=/run/cseries-remote-cert/status.json
Volume=cseries-remote-door-key.volume:/run/cseries-door:ro
Volume=cseries-remote-acme.volume:/var/lib/cseries-remote:U
Volume=cseries-remote-cert-status.volume:/run/cseries-remote-cert:ro
EOF
}

# What Quadlet says about the guest's units, for a unit it could not make:
# its errors only (not its "Loading source" lines), on one line, since the
# cseries command shows the first line of what this prints.
quadlet_says() {
    q=$R/usr/libexec/podman/quadlet
    [ -x "$q" ] || return 0
    said=$("$q" -dryrun 2>&1 >/dev/null | sed -n 's/^quadlet-generator\[[0-9]*\]: //p' |
        grep -v '^Loading source' | grep -i 'cseries' | head -3 | tr '\n' ' ') || true
    [ -z "$said" ] || printf 'Quadlet: %s' "$said"
}

# The Host's and the database's units as systemd holds them after a reload.
# A unit Quadlet cannot make from its file and drop-ins (a key it does not
# know, in a drop-in configure wrote) is not-found; a Host already running
# then goes on running its old unit, on its old image and networks, and a
# restart that cannot find the unit leaves it so. That must never pass for an
# update.
units_made() {
    for u in cseries-postgres.service cseries-host.service; do
        [ "$(systemctl show -p LoadState --value "$u" 2>/dev/null)" = loaded ] ||
            die "systemd has no $u: Quadlet could not make it from $UNITS. $(quadlet_says)"
    done
}

# With remote access configured (configure's remote.conf drop-in), the Host
# must be running on the remote network: a drop-in its unit did not take
# leaves the Host up on its old networks with its door unreachable.
REMOTE_NET=cseries_remote
on_remote_network() {
    [ -f "$UNITS/cseries-host.container.d/remote.conf" ] || return 0
    nets=$(podman inspect cseries-host --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' 2>/dev/null) || nets=""
    case " $nets " in
        *" $REMOTE_NET "*) return 0 ;;
    esac
    die "The Host started without its remote-access network ($REMOTE_NET; it is on: ${nets:-none}), so remote access cannot reach it. Its unit did not take $UNITS/cseries-host.container.d/remote.conf. $(quadlet_says)"
}

image_of() {
    # The Image= line configure wrote for $1 (host, postgres or remote-door),
    # or nothing.
    f="$UNITS/cseries-$1.container.d/image.conf"
    [ -f "$f" ] || return 0
    sed -n 's/^Image=//p' "$f"
}

# An image reference as configure accepts it: a name pinned by digest, which
# podman finds in its own store or pulls, and never takes a moved tag for.
valid_ref() {
    case "$1" in
        *[!a-z0-9._/:@-]*|"") return 1 ;;
        *@sha256:*) ;;
        *) return 1 ;;
    esac
    digest=${1##*@sha256:}
    [ ${#digest} -eq 64 ] || return 1
    case "$digest" in *[!0-9a-f]*) return 1 ;; esac
    return 0
}

write_if_changed() {
    # $1 path, $2 content. Prints 1 when the file changed, 0 when not.
    if [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]; then
        echo 0
        return
    fi
    mkdir -p "$(dirname "$1")"
    printf '%s\n' "$2" > "$1.new"
    mv "$1.new" "$1"
    echo 1
}

# A URL as the image table takes it: http(s), and no character a JSON string
# or a shell would read as anything else.
valid_url() {
    case "$1" in
        http://*|https://*) ;;
        *) return 1 ;;
    esac
    case "$1" in *[!A-Za-z0-9._~:/%+-]*) return 1 ;; esac
    return 0
}

hex64() {
    [ ${#1} -eq 64 ] || return 1
    case "$1" in *[!0-9a-f]*) return 1 ;; esac
    return 0
}

# The local runtime's image table: each family the release pins, and the
# engines' sources. Only the keys given; a family missing is one the runtime
# refuses.
runtime_images() {
    out='{
  "images": {'
    sep=""
    for fam in python creative helper browser; do
        eval "ref=\$rt_$fam"
        [ -n "$ref" ] || continue
        out="$out$sep
    \"$fam\": \"$ref\""
        sep=","
    done
    out="$out
  }"
    if [ -n "$rt_hs_url" ]; then
        out="$out,
  \"harness_src\": {\"url\": \"$rt_hs_url\", \"sha256\": \"$rt_hs_sha\"}"
    fi
    printf '%s\n}' "$out"
}

# The browser's control token, made once: the runtime gives it to the browser
# container and the Host sends it with every call (without one the browser
# would take any caller on its port).
browser_token() {
    f=$RT_ETC/browser-control-token
    if [ ! -s "$f" ]; then
        mkdir -p "$RT_ETC"
        tok=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
        hex64 "$tok" || die "configure: could not make the browser's control token"
        (umask 077 && printf '%s\n' "$tok" > "$f.new" && mv "$f.new" "$f")
    fi
    tok=$(cat "$f")
    (umask 077 && printf 'BROWSER_CONTROL_TOKEN=%s\n' "$tok" > "$f.env.new" && mv "$f.env.new" "$f.env")
    chmod 0600 "$f" "$f.env"
}

configure() {
    host="" postgres="" release="" cpu_quota="" memory_max="" door=""
    rt_python="" rt_creative="" rt_helper="" rt_browser="" rt_hs_url="" rt_hs_sha="" rt_given=""
    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            host) host=$value ;;
            postgres) postgres=$value ;;
            release) release=$value ;;
            cpu_quota) cpu_quota=$value ;;
            memory_max) memory_max=$value ;;
            door)
                valid_ref "$value" || die "configure: door image is not pinned by digest: $value"
                door=$value ;;
            python|creative|helper|browser)
                valid_ref "$value" || die "configure: $key image is not pinned by digest: $value"
                eval "rt_$key=\$value"
                rt_given=1 ;;
            harness_src_url)
                valid_url "$value" || die "configure: harness_src_url is not an http(s) URL: $value"
                rt_hs_url=$value rt_given=1 ;;
            harness_src_sha256)
                hex64 "$value" || die "configure: harness_src_sha256 is not 64 hex characters"
                rt_hs_sha=$value rt_given=1 ;;
            "") ;;
            *) die "configure: unknown key $key" ;;
        esac
    done
    valid_ref "$host" || die "configure: host image is not pinned by digest: $host"
    valid_ref "$postgres" || die "configure: postgres image is not pinned by digest: $postgres"
    case "$release" in
        *[!0-9A-Za-z.+-]*|"") die "configure: release is not a version: $release" ;;
    esac
    # cpu_quota (optional): how much processor time the Host may use, as
    # systemd's CPUQuota= takes it (100% is one processor). The cseries
    # command sends it from the count `status` reports; without it the file
    # is left as it is.
    case "$cpu_quota" in
        "") ;;
        [1-9]*%) case "${cpu_quota%\%}" in *[!0-9]*) die "configure: cpu_quota is not a percentage: $cpu_quota" ;; esac ;;
        *) die "configure: cpu_quota is not a percentage: $cpu_quota" ;;
    esac
    # memory_max (optional): the Host's memory ceiling, as systemd's
    # MemoryMax= takes it, in MiB ("2460M"). The cseries command sends it from
    # the MemTotal `status` reports, less the system's reserve and the
    # database's 512 MB; without it the file is left as it is, and the base
    # unit's share stands.
    case "$memory_max" in
        "") ;;
        [1-9]*M) case "${memory_max%M}" in *[!0-9]*) die "configure: memory_max is not a size in MiB: $memory_max" ;; esac ;;
        *) die "configure: memory_max is not a size in MiB: $memory_max" ;;
    esac
    if [ -n "$rt_hs_url$rt_hs_sha" ] && { [ -z "$rt_hs_url" ] || [ -z "$rt_hs_sha" ]; }; then
        die "configure: harness_src_url and harness_src_sha256 go together"
    fi
    a=$(write_if_changed "$UNITS/cseries-host.container.d/image.conf" "[Container]
Image=$host")
    b=$(write_if_changed "$UNITS/cseries-postgres.container.d/image.conf" "[Container]
Image=$postgres")
    c=$(write_if_changed "$STATE/release" "$release")
    d=0
    if [ -n "$cpu_quota" ]; then
        d=$(write_if_changed "$UNITS/cseries-host.container.d/10-cpu.conf" "# Written by cseries-guest configure from this system's processor count.
[Service]
CPUQuota=$cpu_quota")
    fi
    # door (optional): the remote-access door's image, for both of its units,
    # and the Host's drop-in that joins it to the door's network
    # (remote_host_dropin). Without it the files are left as they are, so a
    # release without the door never takes away one an earlier release
    # configured.
    h=0
    if [ -n "$door" ]; then
        h1=$(write_if_changed "$UNITS/cseries-remote-door.container.d/image.conf" "[Container]
Image=$door")
        h2=$(write_if_changed "$UNITS/cseries-remote-cert.container.d/image.conf" "[Container]
Image=$door")
        h3=$(write_if_changed "$UNITS/cseries-host.container.d/remote.conf" "$(remote_host_dropin)")
        h=$h1$h2$h3
    fi
    e=0
    if [ -n "$memory_max" ]; then
        e=$(write_if_changed "$UNITS/cseries-host.container.d/10-memory.conf" "# Written by cseries-guest configure from this system's memory.
[Service]
MemoryMax=$memory_max")
    fi
    f=0
    if [ -x "$RT_BIN" ]; then
        if [ -n "$rt_given" ]; then
            g=$(write_if_changed "$RT_ETC/images.json" "$(runtime_images)")
            : "$g"
        fi
        browser_token
        gid=$(getent group cseries-runtime | cut -d: -f3)
        [ -n "$gid" ] || die "configure: the cseries-runtime group is missing"
        f=$(write_if_changed "$UNITS/cseries-host.container.d/runtime.conf" "# The Host's side of the local runtime (cseries-runtime): its network,
# its socket and the browser's control token. Written by cseries-guest configure.
[Unit]
Requires=cseries-runtime.socket
After=cseries-runtime.socket

[Container]
Network=cseries-apps.network:ip=$RT_HOST_IP,mac=$RT_HOST_MAC
Volume=/run/cseries-runtime:/run/cseries-runtime
GroupAdd=$gid
Environment=CSERIES_RUNTIME_SOCKET=/run/cseries-runtime/runtime.sock
Environment=CSERIES_RUNTIME_KERNEL_ADDR=$RT_HOST_IP:8800
Environment=CSERIES_RUNTIME_NET=$RT_NET
EnvironmentFile=/etc/cseries-runtime/browser-control-token.env")
    fi
    case "$a$b$d$e$f$h" in
        *1*) any=1 ;;
        *) any=0 ;;
    esac
    if [ "$any" = 1 ]; then
        systemctl daemon-reload
        units_made
        echo changed=1
    else
        echo changed=0
    fi
    : "$c"
}

runtime_image_of() {
    # The ref the image table pins for family $1, or nothing.
    [ -f "$RT_ETC/images.json" ] || return 0
    sed -n "s/^ *\"$1\": \"\([^\"]*\)\".*/\1/p" "$RT_ETC/images.json"
}

# The door's two units, when configure has given them their image; their
# own failure is theirs (journalctl -u cseries-remote-door), never the Host's.
# Queued without waiting: a unit still pulling its image would otherwise hold
# the Host's start for as long as the pull takes.
door_units() {
    [ -n "$(image_of remote-door)" ] || return 0
    systemctl --no-block "$1" $DOOR_UNITS 2>/dev/null || true
}

need_config() {
    [ -n "$(image_of host)" ] && [ -n "$(image_of postgres)" ] ||
        die "No images are configured in this guest yet. Run the cseries command on the machine again."
}

unit_state() {
    s=$(systemctl is-active "$1" 2>/dev/null) || true
    printf '%s' "${s:-unknown}"
}

# Starts (or restarts) both units and returns once both are running. A unit
# whose first attempt fails is retried by systemd (Restart=always), so the
# answer is the units' state after those retries, not the first systemctl
# call's exit status.
run_units() {
    # A unit that is not-found but still active is the old Host: the call
    # below fails for it and the wait would take it for started.
    units_made
    systemctl "$1" cseries-postgres.service cseries-host.service 2>/dev/null || true
    door_units "$1"
    i=0
    while [ $i -lt 90 ]; do
        if [ "$(unit_state cseries-postgres.service)" = active ] &&
           [ "$(unit_state cseries-host.service)" = active ]; then
            on_remote_network
            return 0
        fi
        sleep 2
        i=$((i + 1))
    done
    systemctl status --no-pager --lines 15 cseries-postgres.service cseries-host.service >&2 || true
    die "The Host's containers did not start. Their logs: cseries-guest logs host, cseries-guest logs postgres"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
    wait-boot)
        # The first command into a just-started VM can run before systemd
        # answers on its bus; an empty answer is asked again. degraded still
        # means boot finished; the Host's units are checked on their own.
        s="" i=0
        while [ $i -lt 180 ]; do
            leave_root_cgroup
            s=$(timeout 180 systemctl is-system-running --wait 2>/dev/null) || true
            [ -n "$s" ] && break
            sleep 1
            i=$((i + 1))
        done
        echo "system=${s:-unknown}"
        case "$s" in running|degraded) ;; *) exit 1 ;; esac
        ;;
    configure)
        configure
        ;;
    pull)
        need_config
        for which in postgres host; do
            ref=$(image_of "$which")
            podman image exists "$ref" || podman pull "$ref"
        done
        # The messaging connectors run on the python image, so it comes with
        # the Host; the browser's and the creative engines' come on first use.
        ref=$(runtime_image_of python)
        if [ -n "$ref" ]; then
            podman image exists "$ref" || podman pull "$ref"
        fi
        # The door's image, when configured: both of its units run it. A
        # download that fails is not the Host's: its units pull it again when
        # they start (Pull=missing).
        ref=$(image_of remote-door)
        if [ -n "$ref" ]; then
            podman image exists "$ref" || podman pull "$ref" ||
                echo "The remote-access door's image could not be downloaded; its units try again when they start." >&2
        fi
        ;;
    start)
        need_config
        run_units start
        ;;
    stop)
        # Each unit on its own line: a guest whose door has no image has no
        # door units, and that must not stop the Host's from stopping.
        systemctl stop $DOOR_UNITS 2>/dev/null || true
        systemctl stop cseries-host.service cseries-postgres.service 2>/dev/null || true
        ;;
    restart)
        need_config
        run_units restart
        ;;
    status)
        echo "guest=$(cat "$STATE/guest-version" 2>/dev/null || echo unknown)"
        echo "release=$(cat "$STATE/release" 2>/dev/null || echo none)"
        echo "host_image=$(image_of host)"
        echo "postgres_image=$(image_of postgres)"
        echo "host=$(unit_state cseries-host.service)"
        echo "postgres=$(unit_state cseries-postgres.service)"
        echo "cpus=$(getconf _NPROCESSORS_ONLN)"
        echo "mem_total_kb=$(sed -n 's/^MemTotal: *\([0-9]*\) kB$/\1/p' /proc/meminfo)"
        echo "runtime=$(unit_state cseries-runtime.socket)"
        echo "door_image=$(image_of remote-door)"
        echo "door=$(unit_state cseries-remote-door.service)"
        echo "remote_cert=$(unit_state cseries-remote-cert.service)"
        if curl -fsS --max-time 3 -o /dev/null http://127.0.0.1:8800/api/system/health 2>/dev/null; then
            echo "health=ok"
        else
            echo "health=down"
        fi
        ;;
    health)
        curl -fsS --max-time 3 -o /dev/null http://127.0.0.1:8800/api/system/health
        ;;
    ready)
        # Liveness says only that the web server answers. A Host whose
        # database is down or whose migrations did not apply answers it too,
        # and cannot serve a chat; the deep check answers 503 for that.
        # Asked from inside the Host's container: from here the port forward
        # delivers the request from the network's gateway, and once the Host
        # has an owner only loopback reaches the deep check without a session.
        body=$(podman exec cseries-host curl -fsS --max-time 10 \
            http://127.0.0.1:8800/api/system/health/deep </dev/null) || exit 1
        printf '%s' "$body" | grep -Eq '"status": *"ready"'
        ;;
    logs)
        which=${1:-host}
        [ $# -gt 0 ] && shift
        case "$which" in host|postgres) ;; *) die "logs: host or postgres" ;; esac
        lines=200 follow=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --follow|-f) follow=-f ;;
                --lines|-n) shift; lines=${1:-200} ;;
                *) die "logs: unknown option $1" ;;
            esac
            shift
        done
        case "$lines" in *[!0-9]*|"") die "logs: --lines takes a number" ;; esac
        exec journalctl -u "cseries-$which.service" --no-pager -o cat -n "$lines" $follow
        ;;
    host-log)
        # Both streams in the order the Host wrote them: the newest setup code
        # is the last one.
        exec podman logs --tail 5000 cseries-host 2>&1
        ;;
    pair-token)
        exec podman exec cseries-host python3 -m cli.cseries bastion pair-token
        ;;
    keepalive)
        exec flock -n /run/cseries-keepalive.lock sleep infinity
        ;;
    version)
        cat "$STATE/guest-version"
        ;;
    *)
        die "usage: cseries-guest wait-boot|configure|pull|start|stop|restart|status|health|ready|logs|host-log|pair-token|keepalive|version"
        ;;
esac
