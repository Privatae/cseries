# The door itself: one site's rules, the same for both of a Host's doors, so
# there is one door to secure. The cloud box's front door
# (vm/cloud/overlay/etc/caddy/Caddyfile.in) and the remote-access door
# (sidecars/remote-door/Caddyfile, whose image copies this file beside it)
# each import it inside their site for the Host's names, after the site's own
# tls line; what differs between them (where they listen, the PROXY header in
# front of the remote door, the certificate's path, the unlock page) stays in
# their own files.
#
# Nothing reaches the Host before the Host itself has answered forward_auth
# for that request, and nothing from outside reaches the door that answers it.
#
# Every value comes from the environment when Caddy reads the file:
#   CSERIES_HOST_UPSTREAM  the Host's <address>:8800 (a cloud box: its fixed
#                          container address, from caddy.service.d/door.conf;
#                          the remote door: the Host's address on the remote
#                          network, from its unit)
#   CSERIES_DOOR_SECRET    the door key (never written in a file Caddy reads)
#   CSERIES_UNLOCK_HOST    a cloud box's unlock page, named by the locked
#                          answer below; the remote door has no vault, never
#                          finds /run/cseries-vault/locked, and leaves it unset

# The Host sets its own framing, CSP and Referrer-Policy.
header {
	Strict-Transport-Security "max-age=63072000; includeSubDomains"
	X-Content-Type-Options nosniff
	-Server
}
# The Host's door answers Caddy's forward_auth question and nobody else:
# a request from outside for it ends here, before it is asked about or
# passed on. The path matcher compares the decoded, lower-cased path, so
# /__host%2Fdoor and /__HOST/door end here too.
@door path /__host/door /__host/door/*
handle @door {
	respond 404
}
handle {
	forward_auth {$CSERIES_HOST_UPSTREAM} {
		uri /__host/door
		# The door key tells the Host this is Caddy's own question, so
		# it believes X-Forwarded-Method and -Uri only here. Set, not
		# added: a value a client sent is replaced. The key comes from the
		# environment when the Caddyfile is read, at each start and reload:
		# on a cloud box from /etc/cseries-cloud/door-secret.env
		# (caddy.service.d/cloud.conf), in the remote door from door-run.
		header_up X-Cseries-Door {$CSERIES_DOOR_SECRET}
	}
	reverse_proxy {$CSERIES_HOST_UPSTREAM} {
		# Caddy sets these two on the forward_auth question only. A
		# client's own copies are removed, so the Host never reads a
		# request's method or URI from a header the client wrote.
		header_up -X-Forwarded-Method
		header_up -X-Forwarded-Uri
		# Nor the door key: a request passed on never carries it.
		header_up -X-Cseries-Door
	}
}
# While the Host restarts (a restore swapping in, an update, a reboot)
# nothing answers on its port, and Caddy's own answer to the door's
# question or the request would be 502 Bad Gateway (504 on a timeout).
# Those get the starting answer instead, 503 with Retry-After: a page that
# reloads itself for a browser, and for a call the error the sign-in page
# shows. What the Host answers itself, a 502 of its own or the door's 401
# and 403, is a response and not an error here, so it is passed on as it is.
handle_errors {
	# An error answer starts with fresh headers: the site's are set again.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	@starting expression `{err.status_code} in [502, 503, 504]`
	# While the vault is locked the Host is not running at all: the
	# answer is where to unlock it (cseries-vault keeps the marker).
	@locked {
		expression `{err.status_code} in [502, 503, 504]`
		file {
			root /run/cseries-vault
			try_files /locked
		}
	}
	handle @locked {
		header Cache-Control no-store
		@lockedpage header Accept *text/html*
		handle @lockedpage {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Locked</title></head><body style="font-family:system-ui,sans-serif;margin:3rem auto;max-width:32rem;padding:0 1rem;color:#222"><h1 style="font-size:1.4rem">This machine is locked</h1><p>It restarted, and its disk stays locked until its owner unlocks it.</p><p><a href="https://{$CSERIES_UNLOCK_HOST}/">Unlock it</a></p></body></html>` 503
		}
		handle {
			header Content-Type "application/json"
			respond `{"error": "This machine is locked. Unlock it at https://{$CSERIES_UNLOCK_HOST}/"}` 503
		}
	}
	handle @starting {
		header Retry-After 5
		header Cache-Control no-store
		@page header Accept *text/html*
		handle @page {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content="5"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Starting</title></head><body style="font-family:system-ui,sans-serif;margin:3rem auto;max-width:32rem;padding:0 1rem;color:#222"><h1 style="font-size:1.4rem">This Host is starting</h1><p>It will be ready in a few seconds. This page tries again by itself.</p></body></html>` 503
		}
		handle {
			header Content-Type "application/json"
			respond `{"error": "This Host is starting. Try again in a few seconds."}` 503
		}
	}
}
