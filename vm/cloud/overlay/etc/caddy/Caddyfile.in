# The cloud box's front door (bootstrap renders this file). Two sites: the
# unlock page, and every name under @ZONE_HOST@, which is the Host and its app
# origins, on 443 with TLS 1.3 only and the box's wildcard certificate. The
# Host's site imports the door's rules from host-door.caddy, which the
# remote-access door imports too: nothing reaches the Host before the Host
# itself has answered forward_auth for that request, and nothing from outside
# reaches the door that answers it.
{
	admin unix//run/caddy/admin.sock
	# The certificate is the box's own (cseries-cert); Caddy fetches none
	# and listens on nothing but 443.
	auto_https disable_redirects
	ocsp_stapling off
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			idle 5m
		}
	}
}

# The unlock page (cseries-unlock-agent; cseries_vault has what the vault is).
# The page is the overlay's own files, from the signed release; only /api/*
# reaches the agent, which opens the disk with a key the customer holds.
# Nothing of the Host is served here, so no page of the Host's (nor of any
# of its apps) shares this origin, the unlock passkeys' relying party.
# Forms go to this page's own agent (the setup code typed here) and to the
# Host (the sign-in ticket), nowhere else. The referrer policy sends this
# origin and nothing more: its form posts then carry an Origin the agent and
# the Host check (no-referrer would make it "null"), and no address here
# holds anything but the page.
https://@UNLOCK_HOST@ {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; form-action 'self' https://@HOST_NAME@; frame-ancestors 'none'; base-uri 'none'"
		Referrer-Policy strict-origin
		X-Frame-Options DENY
		Cache-Control no-store
		-Server
	}
	handle /api/* {
		reverse_proxy unix//run/cseries-unlock/agent.sock {
			# The agent counts tries per source: the address Caddy saw, and
			# never one a client wrote.
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		root * /usr/share/cseries-cloud/unlock
		file_server
	}
}

https://*.@ZONE_HOST@ {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem {
		protocols tls1.3
	}
	# The Host's door (host-door.caddy, beside this file): the same rules as
	# the remote-access door's, with this box's Host and unlock page from
	# caddy.service.d/door.conf and the door key from door-secret.env.
	import host-door.caddy
}
